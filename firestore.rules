rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Products: lisibles par tous, modifiables par admin
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Users: lecture/écriture par l'utilisateur concerné ou admin
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Orders: lecture/écriture par utilisateurs authentifiés
    match /orders/{orderId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Carts: chaque utilisateur accède à son propre panier
    match /carts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Config/Settings: lisible par tous, modifiable par admin
    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Supplier Mappings: lecture/écriture par admin
    match /supplierMappings/{productId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Supplier Orders: lecture/écriture par admin
    match /supplierOrders/{orderId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
